function reverse_array (n, inputArr) {
    let nums = [];
    for (let i = 0; i < n; i++) {
        current_num = inputArr.shift();
        nums.push(current_num);
    }
    result = nums.reverse().join(' ');
    console.log(result);
}

reverse_array(3, [10, 20, 30, 40, 50]);
reverse_array(4, [-1, 20, 99, 5]);
reverse_array(2, [66, 43, 75, 89, 47]);